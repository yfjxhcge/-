-- 随机音乐播放系统
local function playRandomMusic()
    -- 音乐列表：Iron Lotus 和 虚荣屠夫
    local musicList = {
        {
            name = "Iron Lotus",
            id = "rbxassetid://9117342830"  -- 示例音乐ID，可以替换为实际ID
        },
        {
            name = "虚荣屠夫", 
            id = "rbxassetid://9117342845"  -- 示例音乐ID，可以替换为实际ID
        }
    }
    
    -- 随机选择一首音乐
    local randomMusic = musicList[math.random(1, #musicList)]
    
    -- 创建声音服务
    local soundService = game:GetService("SoundService")
    local backgroundSound = Instance.new("Sound")
    backgroundSound.SoundId = randomMusic.id
    backgroundSound.Volume = 0.5
    backgroundSound.Looped = true
    backgroundSound.Parent = soundService
    
    -- 更新音乐显示
    musicLabel.Text = "当前播放: " .. randomMusic.name
    
    -- 播放音乐
    backgroundSound:Play()
    
    return backgroundSound
end

