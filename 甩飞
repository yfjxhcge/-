local BTN = Instance.new("TextButton", FRAME)
BTN.Size = UDim2.new(0, 180, 0, 40)
BTN.Position = UDim2.new(0.5, -90, 0.55, 0)
BTN.BackgroundColor3 = Color3.new(0, 0.6, 1)
BTN.BackgroundTransparency = 0.3
BTN.Text = "FLY OFF"
BTN.TextColor3 = Color3.new(1, 1, 1)
BTN.TextSize = 16
BTN.Font = Enum.Font.SourceSansSemibold

local BTN_BORDER = Instance.new("UIStroke", BTN)
BTN_BORDER.Color = Color3.new(0, 1, 1)
BTN_BORDER.Transparency = 0.2
BTN_BORDER.Thickness = 1.5

local function TWEEN(obj, prop, val, time)
    game:GetService("TweenService"):Create(obj, TweenInfo.new(time), {[prop] = val}):Play()
end

BTN.MouseButton1Click:Connect(function()
    Enabled = not Enabled
    BTN.Text = Enabled and "FLY ON" or "FLY OFF"

    TWEEN(BTN, "BackgroundColor3", Enabled and Color3.new(0,1,0.4) or Color3.new(0,0.6,1), 0.15)
    TWEEN(BTN_BORDER, "Transparency", Enabled and 0 or 0.2, 0.15)

    if not Enabled then
        targetPlayer = nil
        originalCFrame = nil
    end
end)

local dragging, dragStart, startPos
FRAME.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = FRAME.Position
    end
end)

FRAME.InputChanged:Connect(function(input)
    if dragging then
        local delta = input.Position - dragStart
        FRAME.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

FRAME.InputEnded:Connect(function(input)
    dragging = false
end)
