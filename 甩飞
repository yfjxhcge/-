EFFECT.Transparency = NumberSequence.new(0.3)

local TITLE = Instance.new("TextLabel", FRAME)
TITLE.Size = UDim2.new(1, 0, 0, 30)
TITLE.BackgroundColor3 = Color3.new(0, 0.2, 0.4)
