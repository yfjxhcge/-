-- 飞行功能变量
local flyEnabled = false
local flySpeed = 50
local flyBodyVelocity
local flyConnection

-- 飞行功能开关
local FlyToggle = MainTab:CreateToggle({
    Name = "飞行功能",
    CurrentValue = false,
    Flag = "Fly",
    Callback = function(Value)
        flyEnabled = Value
        local player = game.Players.LocalPlayer
        local character = player.Character
        
        if not character or not character:FindFirstChild("HumanoidRootPart") then
            Rayfield:Notify({
                Title = "错误",
                Content = "角色未加载完成，请稍后再试",
                Duration = 3,
            })
            return
        end
        
        if flyEnabled then
            Rayfield:Notify({
                Title = "飞行功能",
                Content = "飞行功能已激活 - 使用WASD控制方向，空格上升，Shift下降",
                Duration = 5,
            })
            
            -- 创建飞行体
            flyBodyVelocity = Instance.new("BodyVelocity")
            flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            flyBodyVelocity.MaxForce = Vector3.new(40000, 40000, 40000)
            flyBodyVelocity.Parent = character.HumanoidRootPart
            
            -- 飞行控制连接
            flyConnection = game:GetService("RunService").Heartbeat:Connect(function()
                if not flyEnabled or not character or not character.Parent then
                    if flyConnection then
                        flyConnection:Disconnect()
                    end
                    return
                end
                
                local root = character.HumanoidRootPart
                if not root then
                    if flyConnection then
                        flyConnection:Disconnect()
                    end
                    return
                end
                
                -- 获取相机方向
                local camera = workspace.CurrentCamera
                local lookVector = camera.CFrame.LookVector
                local rightVector = camera.CFrame.RightVector
                
                -- 飞行控制
                local velocity = Vector3.new(0, 0, 0)
                
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) then
                    velocity = velocity + (lookVector * flySpeed)
                end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) then
                    velocity = velocity - (lookVector * flySpeed)
                end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.D) then
                    velocity = velocity + (rightVector * flySpeed)
                end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.A) then
                    velocity = velocity - (rightVector * flySpeed)
                end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) then
                    velocity = velocity + Vector3.new(0, flySpeed, 0)
                end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftShift) then
                    velocity = velocity - Vector3.new(0, flySpeed, 0)
                end
                
                flyBodyVelocity.Velocity = velocity
            end)
        else
            Rayfield:Notify({
                Title = "飞行功能",
                Content = "飞行功能已关闭",
                Duration = 3,
            })
            
            -- 移除飞行体
            if flyBodyVelocity then
                flyBodyVelocity:Destroy()
                flyBodyVelocity = nil
            end
            
            -- 断开连接
            if flyConnection then
                flyConnection:Disconnect()
                flyConnection = nil
            end
        end
    end,
})

