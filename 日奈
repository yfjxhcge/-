-- 穿墙模式功能
local noclipEnabled = false
local noclipConnection

local NoClipToggle = MainTab:CreateToggle({
    Name = "穿墙功能",
    CurrentValue = false,
    Flag = "NoClip",
    Callback = function(Value)
        noclipEnabled = Value
        local player = game.Players.LocalPlayer
        local character = player.Character
        
        if not character then
            Rayfield:Notify({
                Title = "错误",
                Content = "角色未加载完成，请稍后再试",
                Duration = 3,
            })
            return
        end
        
        if noclipEnabled then
            Rayfield:Notify({
                Title = "穿墙模式",
                Content = "穿墙模式已激活",
                Duration = 3,
            })
            
            -- 穿墙逻辑
            noclipConnection = game:GetService("RunService").Stepped:Connect(function()
                if not noclipEnabled or not character or not character.Parent then
                    if noclipConnection then
                        noclipConnection:Disconnect()
                    end
                    return
                end
                
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end)
        else
            Rayfield:Notify({
                Title = "穿墙模式",
                Content = "穿墙模式已关闭",
                Duration = 3,
            })
            
            -- 断开连接
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
            end
            
            -- 恢复碰撞
            if character then
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end
    end,
})

-- 角色重生时重置所有功能
game.Players.LocalPlayer.CharacterAdded:Connect(function(character)
    -- 等待角色完全加载
    character:WaitForChild("Humanoid")
    
    -- 重新应用移动速度设置
    local walkSpeedValue = Rayfield.Flags["WalkSpeed"]
    if walkSpeedValue then
        character.Humanoid.WalkSpeed = walkSpeedValue
    end
    
    -- 重新应用跳跃高度设置
    local jumpPowerValue = Rayfield.Flags["JumpPower"]
    if jumpPowerValue then
        character.Humanoid.JumpPower = jumpPowerValue
    end
    
    -- 重置飞行状态
    flyEnabled = false
    if flyBodyVelocity then
        flyBodyVelocity:Destroy()
        flyBodyVelocity = nil
    end
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    
    -- 更新飞行开关状态
    if FlyToggle then
        FlyToggle:Set(false)
    end
    
    -- 重置穿墙状态
    noclipEnabled = false
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    
    -- 更新穿墙开关状态
    if NoClipToggle then
        NoClipToggle:Set(false)
    end
end)

