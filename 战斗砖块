-- ========== 功能4：一击秒杀模式 ==========
local oneHitEnabled = false
local oneHitBtn = createButton("⚔️ 一击秒杀: 关", 165, Color3.fromRGB(60, 60, 60), function()
    oneHitEnabled = not oneHitEnabled
    oneHitBtn.Text = "⚔️ 一击秒杀: " .. (oneHitEnabled and "开" or "关")
    oneHitBtn.BackgroundColor3 = oneHitEnabled and Color3.fromRGB(30, 180, 30) or Color3.fromRGB(60, 60, 60)
end)

-- 一击秒杀循环
spawn(function()
    while wait(0.1) do
        if oneHitEnabled then
            pcall(function()
                -- 把玩家单位伤害拉满
                if _G.BattleBricks and _G.BattleBricks.playerUnits then
                    for _, unit in ipairs(_G.BattleBricks.playerUnits) do
                        if unit.config then
                            unit.config.damage = 99999
                        end
                    end
                end
                
                -- 直接杀附近敌人
                local char = player.Character
                if char and char.PrimaryPart then
                    for _, v in ipairs(workspace:GetChildren()) do
                        if v.Name:find("Enemy_") and v:IsA("BasePart") then
                            if (v.Position - char.PrimaryPart.Position).Magnitude < 50 then
                                v:Destroy()
                            end
                        end
                    end
                end
            end)
        end
    end
end)

