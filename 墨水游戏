-- 功能逻辑部分
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local localPlayer = Players.LocalPlayer
local attackRange = 500 -- 攻击范围设置为500

-- 创建远程事件（如果不存在）
local function createRemoteEvents()
    if not ReplicatedStorage:FindFirstChild("RangeAttackEvent") then
        local rangeEvent = Instance.new("RemoteEvent")
        rangeEvent.Name = "RangeAttackEvent"
        rangeEvent.Parent = ReplicatedStorage
    end
    if not ReplicatedStorage:FindFirstChild("AttackEffectEvent") then
        local effectEvent = Instance.new("RemoteEvent")
        effectEvent.Name = "AttackEffectEvent"
        effectEvent.Parent = ReplicatedStorage
    end
end
createRemoteEvents()

local rangeAttackEvent = ReplicatedStorage:WaitForChild("RangeAttackEvent")
local attackEffectEvent = ReplicatedStorage:WaitForChild("AttackEffectEvent")

-- 优化大范围内的目标检测（只检测玩家角色）
local function getPlayersInRange(center, range)
    local targets = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local character = player.Character
            if character then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local distance = (rootPart.Position - center).Magnitude
                    if distance <= range then
                        table.insert(targets, character)
                    end
                end
            end
        end
    end
    return targets
end

-- 攻击触发函数
local function triggerRangeAttack()
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    -- 获取500范围内的玩家目标
    local targets = getPlayersInRange(humanoidRootPart.Position, attackRange)
    if #targets > 0 then
        rangeAttackEvent:FireServer(targets)
    else
        warn("500范围内没有其他玩家")
    end
end

-- 按钮触发攻击
AttackButton.MouseButton1Click:Connect(triggerRangeAttack)

-- 键盘Q键触发攻击
UserInputService.InputBegan:Connect(function(input, isTyping)
    if not isTyping and input.KeyCode == Enum.KeyCode.Q then
        triggerRangeAttack()
    end
end)

-- 服务器端处理
if RunService:IsServer() then
    rangeAttackEvent.OnServerEvent:Connect(function(playerWhoAttacked, targetCharacters)
        for _, targetCharacter in pairs(targetCharacters) do
            local targetHumanoid = targetCharacter:FindFirstChild("Humanoid")
            if targetHumanoid and targetHumanoid.Health > 0 then
                targetHumanoid:TakeDamage(30) -- 大范围内可适当提高伤害
            end
        end
        attackEffectEvent:FireAllClients(targetCharacters, playerWhoAttacked.Character)
    end)
end

