-- 修复传送功能
local function teleportToPlayer(playerName)
    local success, errorMessage = pcall(function()
        -- 获取目标玩家
        local targetPlayer = game:GetService("Players"):FindFirstChild(playerName)
        if not targetPlayer then
            error("找不到玩家: " .. playerName)
            return
        end
        
        -- 等待目标角色加载
        if not targetPlayer.Character then
            error("目标玩家角色未加载")
            return
        end
        
        -- 获取角色根部件（兼容R6和R15）
        local function getCharacterRoot(character)
            -- 尝试获取HumanoidRootPart（R15）
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                return rootPart
            end
            
            -- 尝试获取Torso（R6）
            local torso = character:FindFirstChild("Torso")
            if torso then
                return torso
            end
            
            -- 尝试获取UpperTorso（R15备用）
            local upperTorso = character:FindFirstChild("UpperTorso")
            if upperTorso then
                return upperTorso
            end
            
            error("找不到角色的根部件")
            return nil
        end
        
        -- 获取本地玩家角色
        local localPlayer = game.Players.LocalPlayer
        if not localPlayer.Character then
            error("你的角色未加载")
            return
        end
        
        -- 获取双方角色的根部件
        local targetRoot = getCharacterRoot(targetPlayer.Character)
        local localRoot = getCharacterRoot(localPlayer.Character)
        
        if not targetRoot or not localRoot then
            error("无法找到传送位置")
            return
        end
        
        -- 执行传送（稍微偏移避免卡在玩家内部）
        local offset = CFrame.new(0, 0, 3)
        localRoot.CFrame = targetRoot.CFrame * offset
        
        return true
    end)
    
    return success, errorMessage
end

