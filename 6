-- 创建动态星空背景
local starsContainer = Instance.new("Frame")
starsContainer.Size = UDim2.new(1, 0, 1, 0)
starsContainer.BackgroundTransparency = 1
starsContainer.Parent = fullscreenFrame

local stars = {}
for i = 1, 150 do
    local star = Instance.new("Frame")
    local size = math.random(1, 4)
    star.Size = UDim2.new(0, size, 0, size)
    star.Position = UDim2.new(math.random(), 0, math.random(), 0)
    star.BackgroundColor3 = Color3.fromRGB(math.random(150, 255), math.random(150, 255), math.random(150, 255))
    star.BorderSizePixel = 0
    star.Parent = starsContainer
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.5, 0)
    corner.Parent = star
    
    stars[i] = {
        object = star,
        speed = math.random(10, 30) / 100,
        direction = Vector2.new(math.random() * 2 - 1, math.random() * 2 - 1),
        blinkSpeed = math.random(5, 20) / 10,
        originalSize = size,
        timeOffset = math.random() * math.pi * 2
    }
end

-- 星星动画
local function animateStars()
    while true do
        local time = tick()
        for i, starData in pairs(stars) do
            local star = starData.object
            local currentTime = time + starData.timeOffset
            
            local alpha = (math.sin(currentTime * starData.blinkSpeed) + 1) / 2
            star.BackgroundTransparency = 0.3 + (0.7 * alpha)
            
            local sizeScale = 0.8 + (0.4 * math.sin(currentTime * starData.blinkSpeed * 0.5))
            star.Size = UDim2.new(0, starData.originalSize * sizeScale, 0, starData.originalSize * sizeScale)
            
            local currentPos = star.Position
            local newX = (currentPos.X.Scale + starData.direction.X * starData.speed / 1000) % 1
            local newY = (currentPos.Y.Scale + starData.direction.Y * starData.speed / 1000) % 1
            star.Position = UDim2.new(newX, 0, newY, 0)
        end
        wait(0.03)
    end
end

coroutine.wrap(animateStars)()

