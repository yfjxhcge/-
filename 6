-- 更新进度函数
local function updateProgress(progress, status)
    progressFill.Size = UDim2.new(progress, 0, 1, 0)
    percentLabel.Text = math.floor(progress * 100) .. "%"
    statusLabel.Text = status
    wait(0.1)
end

-- 主加载函数
local function loadScript()
    updateProgress(0.1, "正在加载Rayfield库...")
    
    -- 加载Rayfield库
    local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
    
    updateProgress(0.3, "正在初始化窗口...")
    
    -- 创建窗口
    local Window = Rayfield:CreateWindow({
        Name = "日奈 - 星空脚本",
        LoadingTitle = "加载中...",
        LoadingSubtitle = "正在初始化功能",
        ConfigurationSaving = {Enabled = true, FileName = "日奈配置"},
        KeySystem = false,
    })
    
    updateProgress(0.5, "正在创建功能界面...")
    
    -- 创建主标签页
    local MainTab = Window:CreateTab("主页面", 4483362458)
    
    -- 移动功能分区
    local MovementSection = MainTab:CreateSection("移动功能")
    
    updateProgress(0.6, "添加移动速度控制...")
    
    -- 移动速度滑块
    local WalkSpeedSlider = MainTab:CreateSlider({
        Name = "移动速度",
        Range = {0, 100},
        Increment = 1,
        Suffix = "速度值",
        CurrentValue = 16,
        Flag = "WalkSpeed",
        Callback = function(Value)
            local player = game.Players.LocalPlayer
            if player.Character then
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.WalkSpeed = Value
                end
            end
        end,
    })
    
    updateProgress(0.7, "添加跳跃高度控制...")
    
    -- 跳跃高度滑块
    local JumpPowerSlider = MainTab:CreateSlider({
        Name = "跳跃高度",
        Range = {0, 100},
        Increment = 1,
        Suffix = "高度值",
        CurrentValue = 50,
        Flag = "JumpPower",
        Callback = function(Value)
            local player = game.Players.LocalPlayer
            if player.Character then
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.JumpPower = Value
                end
            end
        end,
    })
    
    updateProgress(0.8, "添加飞行脚本...")
    
    -- 飞行脚本按钮
    local FlyButton = MainTab:CreateButton({
        Name = "加载飞行脚本",
        Callback = function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/XNEOFF/FlyGuiV3/main/FlyGuiV3.txt"))()
        end,
    })
    
    -- 穿墙功能
    local noclipEnabled = false
    local noclipConnection
    
    local NoClipToggle = MainTab:CreateToggle({
        Name = "穿墙模式",
        CurrentValue = false,
        Flag = "NoClip",
        Callback = function(Value)
            noclipEnabled = Value
            local character = game.Players.LocalPlayer.Character
            if character then
                if noclipEnabled then
                    noclipConnection = game:GetService("RunService").Stepped:Connect(function()
                        for _, part in pairs(character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end)
                else
                    if noclipConnection then
                        noclipConnection:Disconnect()
                    end
                end
            end
        end,
    })
    
    updateProgress(0.9, "创建工具页面...")
    
    -- 工具标签页
    local ToolsTab = Window:CreateTab("工具", 4483362458)
    
    -- 传送功能
    local TeleportSection = ToolsTab:CreateSection("传送功能")
    
    local selectedPlayer = ""
    local PlayerDropdown = ToolsTab:CreateDropdown({
        Name = "选择玩家",
        Options = {},
        CurrentOption = "",
        Flag = "PlayerSelector",
        Callback = function(Option) selectedPlayer = Option end,
    })
    
    local TeleportButton = ToolsTab:CreateButton({
        Name = "传送到玩家",
        Callback = function()
            if selectedPlayer ~= "" then
                local target = game:GetService("Players"):FindFirstChild(selectedPlayer)
                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame
                end
            end
        end,
    })
    
    -- 更新玩家列表函数
    local function updatePlayerList()
        local players = game:GetService("Players"):GetPlayers()
        local playerNames = {}
        for _, player in ipairs(players) do
            if player ~= game.Players.LocalPlayer then
                table.insert(playerNames, player.Name)
            end
        end
        PlayerDropdown:Refresh(playerNames, true)
    end
    updatePlayerList()
    
    updateProgress(1.0, "加载完成！")
    
    -- 延迟后关闭加载界面
    wait(2)
    
    -- 淡出效果
    for i = 1, 20 do
        centerPanel.BackgroundTransparency = i * 0.05 + 0.3
        fullscreenFrame.BackgroundTransparency = i * 0.05
        wait(0.05)
    end
    
    loadingGui:Destroy()
    
    -- 显示完成通知
    Rayfield:Notify({
        Title = "日奈脚本加载完成",
        Content = "所有功能已就绪！",
        Duration = 5,
    })
end

-- 开始加载
coroutine.wrap(loadScript)()
