-- ESP 线条存储
local espLines = {}

local function setupEspForPlayer(player)
    if player == LocalPlayer then return end
    local function ensure()
        if not player.Character then return end
        local head = player.Character:FindFirstChild("Head")
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if not head or not root then return end
        if not espLines[player.UserId] then
            local line = Drawing.new("Line")
            line.Color = Color3.new(1, 0, 0)
            line.Thickness = 2
            line.Transparency = 0.8
            line.Visible = true
            espLines[player.UserId] = line
        end
        local line = espLines[player.UserId]
        RunService.RenderStepped:Connect(function()
            if not player.Character or not line then return end
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local head = player.Character:FindFirstChild("Head")
            if root and head then
                local rootScreenPos, rootOnScreen = Camera:WorldToViewportPoint(root.Position)
                local headScreenPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)
                if rootOnScreen and headOnScreen then
                    line.From = Vector2.new(headScreenPos.X, headScreenPos.Y)
                    line.To = Vector2.new(rootScreenPos.X, rootScreenPos.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            end
        end)
    end
    if player.Character then
        ensure()
    else
        player.CharacterAdded:Connect(function()
            task.wait(0.5)
            ensure()
        end)
    end
end

Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        setupEspForPlayer(player)
    end
end)

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        setupEspForPlayer(player)
    end
end

