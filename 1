-- 穿墙模式功能
local noclipEnabled = false
local noclipConnection

local NoClipToggle = MainTab:CreateToggle({
    Name = "穿墙功能",
    CurrentValue = false,
    Flag = "NoClip",
    Callback = function(Value)
        noclipEnabled = Value
        local player = game.Players.LocalPlayer
        local character = player.Character
        
        if not character then
            Rayfield:Notify({
                Title = "错误",
                Content = "角色未加载完成，请稍后再试",
                Duration = 3,
            })
            return
        end
        
        if noclipEnabled then
            Rayfield:Notify({
                Title = "穿墙模式",
                Content = "穿墙模式已激活",
                Duration = 3,
            })
            
            -- 穿墙逻辑
            noclipConnection = game:GetService("RunService").Stepped:Connect(function()
                if not noclipEnabled or not character or not character.Parent then
                    if noclipConnection then
                        noclipConnection:Disconnect()
                    end
                    return
                end
                
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end)
        else
            Rayfield:Notify({
                Title = "穿墙模式",
                Content = "穿墙模式已关闭",
                Duration = 3,
            })
            
            -- 断开连接
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
            end
            
            -- 恢复碰撞
            if character then
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end
    end,
})

-- 无限跳跃功能
local InfiniteJumpEnabled = false
local InfiniteJumpConnection

local InfiniteJumpToggle = MainTab:CreateToggle({
    Name = "无限跳跃",
    CurrentValue = false,
    Flag = "InfiniteJump",
    Callback = function(Value)
        InfiniteJumpEnabled = Value
        
        if InfiniteJumpEnabled then
            Rayfield:Notify({
                Title = "无限跳跃",
                Content = "无限跳跃已激活",
                Duration = 3,
            })
            
            InfiniteJumpConnection = game:GetService("UserInputService").JumpRequest:Connect(function()
                if InfiniteJumpEnabled then
                    local character = game.Players.LocalPlayer.Character
                    if character and character:FindFirstChildOfClass("Humanoid") then
                        character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
                    end
                end
            end)
        else
            Rayfield:Notify({
                Title = "无限跳跃",
                Content = "无限跳跃已关闭",
                Duration = 3,
            })
            
            if InfiniteJumpConnection then
                InfiniteJumpConnection:Disconnect()
                InfiniteJumpConnection = nil
            end
        end
    end,
})

-- 角色重生时重置所有功能
game.Players.LocalPlayer.CharacterAdded:Connect(function(character)
    -- 等待角色完全加载
    character:WaitForChild("Humanoid")
    
    -- 重新应用移动速度设置
    local walkSpeedValue = Rayfield.Flags["WalkSpeed"]
    if walkSpeedValue then
        character.Humanoid.WalkSpeed = walkSpeedValue
    end
    
    -- 重新应用跳跃高度设置
    local jumpPowerValue = Rayfield.Flags["JumpPower"]
    if jumpPowerValue then
        character.Humanoid.JumpPower = jumpPowerValue
    end
    
    -- 重置穿墙状态
    noclipEnabled = false
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    
    -- 更新穿墙开关状态
    if NoClipToggle then
        NoClipToggle:Set(false)
    end
    
    -- 无限跳跃状态保持不变（因为它是全局的）
end)

