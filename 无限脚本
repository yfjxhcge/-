local function createDropdown(parent, name, options, defaultIndex, onSelect)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 50)
    card.BackgroundColor3 = C.Card
    card.BorderSizePixel = 0
    card.Parent = parent
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)
    card.ClipsDescendants = false

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 100, 0, 20)
    label.Position = UDim2.new(0, 14, 0, 15)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = C.Text
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = card

    local dropdownBtn = Instance.new("TextButton")
    dropdownBtn.Size = UDim2.new(0, 160, 0, 30)
    dropdownBtn.Position = UDim2.new(1, -174, 0, 10)
    dropdownBtn.BackgroundColor3 = C.InputBg
    dropdownBtn.Text = options[defaultIndex or 1] or "选择..."
    dropdownBtn.TextColor3 = C.Text
    dropdownBtn.Font = Enum.Font.Gotham
    dropdownBtn.TextSize = 13
    dropdownBtn.TextXAlignment = Enum.TextXAlignment.Left
    dropdownBtn.BorderSizePixel = 0
    dropdownBtn.Parent = card
    Instance.new("UICorner", dropdownBtn).CornerRadius = UDim.new(0, 6)

    local ddStroke = Instance.new("UIStroke")
    ddStroke.Color = C.Track
    ddStroke.Thickness = 1.5
    ddStroke.Parent = dropdownBtn

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 10)
    padding.PaddingRight = UDim.new(0, 28)
    padding.Parent = dropdownBtn

    local arrow = Instance.new("TextLabel")
    arrow.Size = UDim2.new(0, 20, 1, 0)
    arrow.Position = UDim2.new(1, -24, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▾"
    arrow.TextColor3 = C.SubText
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = 12
    arrow.Parent = dropdownBtn

    -- 下拉列表容器（挂到 sg 上避免被 card 裁剪）
    local listFrame = Instance.new("Frame")
    listFrame.Size = UDim2.new(0, 160, 0, 0)
    listFrame.BackgroundColor3 = C.BgLight
    listFrame.BorderSizePixel = 0
    listFrame.Visible = false
    listFrame.ZIndex = 100
    listFrame.Parent = sg

    local listStroke = Instance.new("UIStroke")
    listStroke.Color = C.Accent
    listStroke.Thickness = 1
    listStroke.Transparency = 0.5
    listStroke.Parent = listFrame

    Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 6)

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 2)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = listFrame

    local isOpen = false
    local selected = options[defaultIndex or 1]

    local function closeList()
        if not isOpen then return end
        isOpen = false
        TweenService:Create(arrow, TweenInfo.new(0.15), { TextColor3 = C.SubText }):Play()
        TweenService:Create(listFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 160, 0, 0)
        }):Play()
        task.delay(0.15, function()
            if not isOpen then listFrame.Visible = false end
        end)
    end

    local function openList()
        if isOpen then return end
        isOpen = true
        -- 定位到按钮下方
        local btnPos = dropdownBtn.AbsolutePosition
        local btnSize = dropdownBtn.AbsoluteSize
        listFrame.Position = UDim2.new(0, btnPos.X, 0, btnPos.Y + btnSize.Y + 4)
        listFrame.Size = UDim2.new(0, 160, 0, 0)
        listFrame.Visible = true
        TweenService:Create(arrow, TweenInfo.new(0.15), { TextColor3 = C.Accent }):Play()
        local targetH = #options * 30 + (#options - 1) * 2 + 8
        TweenService:Create(listFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 160, 0, targetH)
        }):Play()
    end

    -- 构建选项
    for i, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, -8, 0, 30)
        optBtn.Position = UDim2.new(0, 4, 0, 0)
        optBtn.BackgroundColor3 = (opt == selected) and Color3.fromRGB(50, 50, 70) or C.BgLight
        optBtn.Text = "  " .. opt
        optBtn.TextColor3 = (opt == selected) and C.Accent2 or C.Text
        optBtn.Font = Enum.Font.Gotham
        optBtn.TextSize = 13
        optBtn.TextXAlignment = Enum.TextXAlignment.Left
        optBtn.BorderSizePixel = 0
        optBtn.ZIndex = 101
        optBtn.Parent = listFrame
        Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 4)
        optBtn.LayoutOrder = i

        optBtn.MouseEnter:Connect(function()
            if opt ~= selected then
                TweenService:Create(optBtn, TweenInfo.new(0.1), { BackgroundColor3 = C.CardHover }):Play()
            end
        end)
        optBtn.MouseLeave:Connect(function()
            if opt ~= selected then
                TweenService:Create(optBtn, TweenInfo.new(0.1), { BackgroundColor3 = C.BgLight }):Play()
            end
        end)
        optBtn.MouseButton1Click:Connect(function()
            selected = opt
            dropdownBtn.Text = opt
            -- 更新所有选项颜色
            for _, child in ipairs(listFrame:GetChildren()) do
                if child:IsA("TextButton") then
                    if child.Text:match(opt) then
                        child.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
                        child.TextColor3 = C.Accent2
                    else
                        child.BackgroundColor3 = C.BgLight
                        child.TextColor3 = C.Text
                    end
                end
            end
            closeList()
            if onSelect then onSelect(opt, i) end
        end)
    end

    dropdownBtn.MouseButton1Click:Connect(function()
        if isOpen then closeList() else openList() end
    end)

    -- 点击外部关闭
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 and isOpen then
            local mouse = UserInputService:GetMouseLocation()
            local lp = listFrame.AbsolutePosition
            local ls = listFrame.AbsoluteSize
            local bp = dropdownBtn.AbsolutePosition
            local bs = dropdownBtn.AbsoluteSize
            local inList = mouse.X >= lp.X and mouse.X <= lp.X + ls.X and mouse.Y >= lp.Y and mouse.Y <= lp.Y + ls.Y
            local inBtn = mouse.X >= bp.X and mouse.X <= bp.X + bs.X and mouse.Y >= bp.Y and mouse.Y <= bp.Y + bs.Y
            if not inList and not inBtn then
                closeList()
            end
        end
    end)

    card.MouseEnter:Connect(function() TweenService:Create(card, TweenInfo.new(0.15), { BackgroundColor3 = C.CardHover }):Play() end)
    card.MouseLeave:Connect(function() TweenService:Create(card, TweenInfo.new(0.15), { BackgroundColor3 = C.Card }):Play() end)

    return card
end

-- ===== 组件：通知弹窗系统 =====
local notifContainer = Instance.new("Frame")
notifContainer.Size = UDim2.new(0, 280, 1, -20)
notifContainer.Position = UDim2.new(1, -300, 0, 10)
notifContainer.BackgroundTransparency = 1
notifContainer.Parent = sg

local notifLayout = Instance.new("UIListLayout")
notifLayout.Padding = UDim.new(0, 8)
notifLayout.SortOrder = Enum.SortOrder.LayoutOrder
notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
notifLayout.Parent = notifContainer

local notifCount = 0

local function notify(title, message, notifType)
    notifType = notifType or "info"
    notifCount += 1

    local colors = {
        info    = { bar = C.Accent2,  icon = "ℹ️" },
        success = { bar = C.Green,     icon = "✅" },
        warning = { bar = C.Yellow,    icon = "⚠️" },
        error   = { bar = C.Red,       icon = "❌" },
    }
    local c = colors[notifType] or colors.info

    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 0)
    card.BackgroundColor3 = C.BgLight
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.LayoutOrder = notifCount
    card.Parent = notifContainer
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 80)
    stroke.Thickness = 1
    stroke.Parent = card

    -- 左侧色条
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 4, 1, 0)
    bar.BackgroundColor3 = c.bar
    bar.BorderSizePixel = 0
    bar.Parent = card

    -- 图标
    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 32, 0, 32)
    icon.Position = UDim2.new(0, 14, 0, 14)
    icon.BackgroundTransparency = 1
    icon.Text = c.icon
    icon.TextSize = 16
    icon.Font = Enum.Font.GothamBold
    icon.Parent = card

    -- 标题
    local tLabel = Instance.new("TextLabel")
    tLabel.Size = UDim2.new(1, -70, 0, 18)
    tLabel.Position = UDim2.new(0, 52, 0, 12)
    tLabel.BackgroundTransparency = 1
    tLabel.Text = title
    tLabel.TextColor3 = C.Text
    tLabel.Font = Enum.Font.GothamBold
    tLabel.TextSize = 14
    tLabel.TextXAlignment = Enum.TextXAlignment.Left
    tLabel.Parent = card

    -- 内容
    local mLabel = Instance.new("TextLabel")
    mLabel.Size = UDim2.new(1, -66, 0, 20)
    mLabel.Position = UDim2.new(0, 52, 0, 30)
    mLabel.BackgroundTransparency = 1
    mLabel.Text = message
    mLabel.TextColor3 = C.SubText
    mLabel.Font = Enum.Font.Gotham
    mLabel.TextSize = 12
    mLabel.TextXAlignment = Enum.TextXAlignment.Left
    mLabel.TextTruncate = Enum.TextTruncate.AtEnd
    mLabel.Parent = card

    -- 进度条
    local progressBg = Instance.new("Frame")
    progressBg.Size = UDim2.new(1, 0, 0, 3)
    progressBg.Position = UDim2.new(0, 0, 1, -3)
    progressBg.BackgroundColor3 = C.Track
    progressBg.BorderSizePixel = 0
    progressBg.Parent = card

    local progressFill = Instance.new("Frame")
    progressFill.Size = UDim2.new(1, 0, 1, 0)
    progressFill.BackgroundColor3 = c.bar
    progressFill.BorderSizePixel = 0
    progressFill.Parent = progressBg

    -- 滑入动画
    card.Size = UDim2.new(1, 0, 0, 0)
    card.Position = UDim2.new(1, 20, 0, 0)  -- 从右侧滑入
    TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, 0, 0, 64),
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    -- 进度条动画
    task.delay(0.3, function()
        TweenService:Create(progressFill, TweenInfo.new(3.5, Enum.EasingStyle.Linear), {
            Size = UDim2.new(0, 0, 1, 0)
        }):Play()
    end)

    -- 自动消失
    task.delay(3.8, function()
        if not card.Parent then return end
        TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(1, 0, 0, 0),
            Position = UDim2.new(1, 20, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        task.delay(0.3, function()
            card:Destroy()
        end)
    end)

    -- 点击关闭
    local clickDetector = Instance.new("TextButton")
    clickDetector.Size = UDim2.new(1, 0, 1, 0)
    clickDetector.BackgroundTransparency = 1
    clickDetector.Text = ""
    clickDetector.Parent = card
    clickDetector.MouseButton1Click:Connect(function()
        if not card.Parent then return end
        TweenService:Create(card, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        task.delay(0.2, function() card:Destroy() end)
    end)
end

