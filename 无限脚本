    gradient.Color = ColorSequence.new(C.Accent, C.Accent2)
    gradient.Rotation = 90
    gradient.Transparency = NumberSequence.new(1, 1)
    gradient.Parent = btn

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C.CardHover }):Play()
        TweenService:Create(gradient, TweenInfo.new(0.15), { Transparency = NumberSequence.new(0.85, 0.85) }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C.Card }):Play()
        TweenService:Create(gradient, TweenInfo.new(0.15), { Transparency = NumberSequence.new(1, 1) }):Play()
    end)
    btn.MouseButton1Click:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.05), { Size = UDim2.new(1, -4, 0, 36) }):Play()
        task.wait(0.05)
        TweenService:Create(btn, TweenInfo.new(0.1), { Size = UDim2.new(1, 0, 0, 40) }):Play()
        if onClick then onClick() end
    end)
    return btn
end

